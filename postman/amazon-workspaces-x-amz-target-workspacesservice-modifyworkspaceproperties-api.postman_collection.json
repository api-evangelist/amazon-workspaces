              "mode": "raw",
              "raw": "{\n  \"WorkspaceId\": \"ws-8zter8v0kislme2xs5dtxcc2ewczx\",\n  \"WorkspaceProperties\": {\n    \"RunningMode\": \"MANUAL\",\n    \"RunningModeAutoStopTimeoutInMinutes\": \"<integer>\",\n    \"RootVolumeSizeGib\": \"<integer>\",\n    \"UserVolumeSizeGib\": \"<integer>\",\n    \"ComputeTypeName\": \"GRAPHICS\",\n    \"Protocols\": [\n      \"WSP\",\n      \"PCOIP\"\n    ]\n  }\n}",
              "options": {
                "raw": {
