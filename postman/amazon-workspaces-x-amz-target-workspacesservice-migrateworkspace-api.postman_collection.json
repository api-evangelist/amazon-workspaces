              "raw": "{\n  \"SourceWorkspaceId\": \"ws-yzh4girpxgzc92rlb1njn7kwn4i2ek4ezjxyj44yn536fdbinftf9d16qisua28\",\n  \"BundleId\": \"wsb-hrp9kmec6tgzzeagts9nzs9gooyo3g6\"\n}",
