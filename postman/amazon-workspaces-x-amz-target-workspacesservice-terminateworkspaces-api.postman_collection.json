              "mode": "raw",
              "raw": "{\n  \"TerminateWorkspaceRequests\": [\n    {\n      \"WorkspaceId\": \"ws-jf1dt2wtwxtdtlqgkdb3701ep9p6mb0snx8vje7jnp80zht3vbf64z7yom3\"\n    }\n  ]\n}",
